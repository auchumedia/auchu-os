# Supabase — va sur supabase.com → ton projet → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anthropic — va sur console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# App URL (pour production sur Vercel, remplace par ton domaine)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# QuickBooks Online — va sur developer.intuit.com → ton app → Keys & OAuth
# redirect_uri à enregistrer dans l'app Intuit : {NEXT_PUBLIC_APP_URL}/api/quickbooks/callback
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
# Génère avec : openssl rand -base64 32
QUICKBOOKS_TOKEN_ENCRYPTION_KEY=
